# Local Vite env (optional). Defaults match API CORS for localhost:5173.
# Development only. Production bootstrap rejects empty or localhost / 127.0.0.1 / ::1 values.
VITE_API_BASE_URL=http://localhost:5295
VITE_GRAPHQL_URL=http://localhost:5295/graphql
# Set true only when the API has Captcha:RequiredForLogin. Leave off for local Development.
# VITE_CAPTCHA_REQUIRED_FOR_LOGIN=true
# VITE_TURNSTILE_SITE_KEY=
