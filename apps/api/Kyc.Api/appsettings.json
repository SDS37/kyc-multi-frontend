{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Kyc.Api": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "kyc-api",
    "Audience": "kyc-clients",
    "ExpiresMinutes": 60
  },
  "Resilience": {
    "NpgsqlCommandTimeoutSeconds": 30,
    "EfMaxRetryCount": 5,
    "EfMaxRetryDelaySeconds": 10,
    "RequestTimeoutSeconds": 60
  }
}
