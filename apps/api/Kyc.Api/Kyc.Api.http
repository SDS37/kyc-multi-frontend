@Kyc.Api_HostAddress = http://localhost:5295

### Register tenant + first admin (anonymous GraphQL)
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "mutation($input: RegisterTenantRequestInput!) { registerTenant(input: $input) { tenantId tenantSlug adminUserId adminEmail } }",
  "variables": {
    "input": {
      "tenantName": "Acme Compliance",
      "tenantSlug": "acme",
      "adminEmail": "admin@acme.example",
      "adminPassword": "ChangeMe1"
    }
  }
}

### Login (anonymous GraphQL; returns short-lived JWT)
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json

{
  "query": "mutation($input: LoginRequestInput!) { login(input: $input) { accessToken tokenType expiresInSeconds } }",
  "variables": {
    "input": {
      "tenantSlug": "acme",
      "email": "admin@acme.example",
      "password": "ChangeMe1"
    }
  }
}

### Authenticated GraphQL query (paste token from login)
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "query": "query { apiStatus }"
}

### List cases (KYC-036) — Customer: own; Reviewer/TenantAdmin: tenant; optional status + pagination
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "query": "query($status: CaseStatus, $skip: Int, $take: Int) { cases(status: $status, skip: $skip, take: $take) { totalCount skip take items { id title status customerUserId updatedAt } } }",
  "variables": {
    "status": null,
    "skip": 0,
    "take": 20
  }
}

### Case detail (KYC-037) — same visibility; FormData + comments; document metadata
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "query": "query($id: UUID!) { case(id: $id) { case { id title status formData customerUserId reviewComment reviewedAt reviewedBy } comments { text createdAt authorUserId } documents { id fileName contentType sizeBytes uploadedAt uploadedBy } } }",
  "variables": {
    "id": "{{caseId}}"
  }
}

### Upload document (KYC-040) — Customer; Draft/Submitted; multipart field "file"; PDF/PNG/JPG ≤10MB
# curl -X POST "http://localhost:5295/api/cases/{{caseId}}/documents" \
#   -H "Authorization: Bearer {{customerAccessToken}}" \
#   -F "file=@./id.pdf;type=application/pdf"

### Start case review (KYC-034) — Reviewer or TenantAdmin; Submitted → InReview
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{reviewerAccessToken}}

{
  "query": "mutation($input: StartCaseReviewRequestInput!) { startCaseReview(input: $input) { id status updatedAt } }",
  "variables": {
    "input": {
      "id": "{{caseId}}"
    }
  }
}

### Approve case (KYC-035) — Reviewer or TenantAdmin; InReview → Approved; comment optional
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{reviewerAccessToken}}

{
  "query": "mutation($input: ApproveCaseRequestInput!) { approveCase(input: $input) { id status reviewedAt reviewedBy reviewComment } }",
  "variables": {
    "input": {
      "id": "{{caseId}}",
      "comment": null
    }
  }
}

### Reject case (KYC-035) — Reviewer or TenantAdmin; InReview → Rejected; comment required
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{reviewerAccessToken}}

{
  "query": "mutation($input: RejectCaseRequestInput!) { rejectCase(input: $input) { id status reviewedAt reviewedBy reviewComment } }",
  "variables": {
    "input": {
      "id": "{{caseId}}",
      "comment": "Missing proof of address"
    }
  }
}

### Customer creates draft case (KYC-031) — tenant/owner from JWT only
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{customerAccessToken}}

{
  "query": "mutation($input: CreateDraftCaseRequestInput!) { createDraftCase(input: $input) { id title status formData tenantId customerUserId createdAt } }",
  "variables": {
    "input": {
      "title": "Onboarding ACME",
      "formData": "{}"
    }
  }
}

### Customer updates draft case (KYC-032) — owner + Draft only
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{customerAccessToken}}

{
  "query": "mutation($input: UpdateDraftCaseRequestInput!) { updateDraftCase(input: $input) { id title status formData updatedAt } }",
  "variables": {
    "input": {
      "id": "{{caseId}}",
      "title": "Onboarding ACME (updated)",
      "formData": "{\"fullName\":\"Ada Lovelace\",\"dateOfBirth\":\"1815-12-10\",\"nationality\":\"British\",\"address\":\"12 Analytical Engine Rd\"}"
    }
  }
}

### Customer submits draft case (KYC-033) — owner + Draft + required FormData
POST {{Kyc.Api_HostAddress}}/graphql
Content-Type: application/json
Authorization: Bearer {{customerAccessToken}}

{
  "query": "mutation($input: SubmitCaseRequestInput!) { submitCase(input: $input) { id status submittedAt updatedAt } }",
  "variables": {
    "input": {
      "id": "{{caseId}}"
    }
  }
}

### Health (anonymous)
GET {{Kyc.Api_HostAddress}}/health

### Ready (anonymous; 503 if Postgres is unreachable)
GET {{Kyc.Api_HostAddress}}/ready

