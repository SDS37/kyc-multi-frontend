{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Kyc.Api": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "UseUtcTimestamp": true
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:5174"
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=kyc_db;Username=kyc;Password=changeme"
  },
  "Jwt": {
    "SigningKey": "local-dev-only-change-me-32chars-min!!",
    "Issuer": "kyc-api",
    "Audience": "kyc-clients",
    "ExpiresMinutes": 60
  },
  "Resilience": {
    "NpgsqlCommandTimeoutSeconds": 30,
    "EfMaxRetryCount": 5,
    "EfMaxRetryDelaySeconds": 10,
    "RequestTimeoutSeconds": 60
  },
  "ObjectStorage": {
    "Provider": "Minio",
    "Endpoint": "http://127.0.0.1:9000",
    "AccessKey": "minio",
    "SecretKey": "changeme1",
    "BucketName": "kyc-documents",
    "ForcePathStyle": true
  },
  "Registration": {
    "AllowPublicRegistration": true,
    "RequireInviteCode": false
  },
  "AuthLimits": {
    "LoginPermitPerMinute": 120,
    "RegisterPermitPerMinute": 30,
    "GraphqlPermitPerMinute": 120
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  },
  "Captcha": {
    "Provider": "none",
    "RequiredForRegister": false,
    "RequiredForLogin": false
  },
  "Seed": {
    "Enabled": true
  }
}
